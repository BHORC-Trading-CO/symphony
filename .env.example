# Symphony fork - environment variables
#
# Copy this file to a private location (e.g., /Users/albert/Work/BHORC/.env or
# ~/.config/symphony/env.sh) and source it before launching Symphony:
#
#   source /Users/albert/Work/BHORC/.env && cd elixir && ./bin/symphony /path/to/WORKFLOW.md
#
# Do NOT commit the populated file. The .gitignore in this repo excludes .env.

# Plane (tracker.kind: plane). Token from Plane → workspace settings → API tokens.
# Read by SymphonyElixir.Config.Schema when WORKFLOW.md sets `tracker.api_key: $PLANE_API_KEY`.
export PLANE_API_KEY=

# Optional: filter Plane issues by assignee user UUID. Leave unset to disable filter.
# export PLANE_ASSIGNEE=

# Linear (tracker.kind: linear) - kept for parity with upstream Symphony.
# export LINEAR_API_KEY=
# export LINEAR_ASSIGNEE=

# Codex auth uses ~/.codex/auth.json (set up via `codex login`). No env var needed.
# Claude Code auth uses Claude Code's own credential store (set up via `claude login`).
# No env var needed.
